# ============================================================
# RHSMART AXIS — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS commiter le .env dans Git !
# ============================================================

# ─── SERVEUR ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── SUPABASE ──────────────────────────────────────────────
# Trouvez ces valeurs dans : https://supabase.com/dashboard > Settings > API
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJ...   # Clé publique (utilisée côté frontend)
SUPABASE_SERVICE_KEY=eyJ... # Clé service (UNIQUEMENT côté backend/serveur)

# ─── ANTHROPIC (IA Assistant) ──────────────────────────────
# Trouvez votre clé sur : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── WHATSAPP BUSINESS API (optionnel) ─────────────────────
# Configurez sur : https://developers.facebook.com
# Laissez vide pour désactiver l'envoi WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── PRODUCTION UNIQUEMENT ─────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://votre-domaine.com
