{
  "version": 2,
  "builds": [
    {"src": "*.html", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/login", "dest": "/login.html"},
    {"src": "/reset-password", "dest": "/reset-password.html"},
    {"src": "/phase3-4", "dest": "/phase3-4.html"},
    {"src": "/", "dest": "/login.html"},
    {"src": "/(.*)", "dest": "/$1"}
  ]
}
